<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Reserva" targetNamespace="https://unbosque.edu.co/marketplace/bpmn">
  <bpmn:collaboration id="Collab_Proceso_Busqueda_Reserva"><bpmn:participant id="Part_Proceso_Busqueda_Reserva" name="Descubrir y reservar alojamiento" processRef="Proceso_Busqueda_Reserva"/></bpmn:collaboration><bpmn:process id="Proceso_Busqueda_Reserva" name="Descubrir y reservar alojamiento" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Reserva">
      <bpmn:lane id="Lane_Huesped" name="Huésped">
        <bpmn:flowNodeRef>Start_Buscar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnviarFiltros</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RevisarCotizacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SolicitarReserva</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rechazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Confirmada</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Marketplace" name="Marketplace">
        <bpmn:flowNodeRef>Task_BuscarDisponibles</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HayResultados</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cotizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Revalidar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Disponible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReservarIdempotente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PagoTest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PagoOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmarBloquear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AuditarNotificar</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Buscar" name="Huésped inicia búsqueda"><bpmn:outgoing>F01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_EnviarFiltros" name="Enviar ciudad, fechas, capacidad y filtros"><bpmn:incoming>F01</bpmn:incoming><bpmn:outgoing>F02</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_BuscarDisponibles" name="Buscar anuncios activos y consultar calendario"><bpmn:incoming>F02</bpmn:incoming><bpmn:outgoing>F03</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_HayResultados" name="¿Hay resultados disponibles?"><bpmn:incoming>F03</bpmn:incoming><bpmn:outgoing>F04</bpmn:outgoing><bpmn:outgoing>F05</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_Cotizar" name="Calcular precio desglosado"><bpmn:incoming>F05</bpmn:incoming><bpmn:outgoing>F06</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_RevisarCotizacion" name="Revisar detalle y cotización"><bpmn:incoming>F06</bpmn:incoming><bpmn:outgoing>F07</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_SolicitarReserva" name="Solicitar reserva con clave idempotente"><bpmn:incoming>F07</bpmn:incoming><bpmn:outgoing>F08</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Revalidar" name="Revalidar anuncio, fechas y disponibilidad al confirmar"><bpmn:incoming>F08</bpmn:incoming><bpmn:outgoing>F09</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Disponible" name="¿Disponible y válido?"><bpmn:incoming>F09</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing><bpmn:outgoing>F11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_ReservarIdempotente" name="Registrar operación de reserva idempotente"><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_PagoTest" name="Ejecutar pago en modo de pruebas"><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_PagoOK" name="¿Resultado permite confirmar?"><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing><bpmn:outgoing>F15</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_ConfirmarBloquear" name="Confirmar reserva y bloquear periodo de forma consistente"><bpmn:incoming>F15</bpmn:incoming><bpmn:outgoing>F16</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_AuditarNotificar" name="Registrar auditoría y notificar participantes"><bpmn:incoming>F16</bpmn:incoming><bpmn:outgoing>F17</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_Rechazo" name="Búsqueda/solicitud rechazada o no disponible"><bpmn:incoming>F04</bpmn:incoming><bpmn:incoming>F10</bpmn:incoming><bpmn:incoming>F14</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="End_Confirmada" name="Reserva confirmada"><bpmn:incoming>F17</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Start_Buscar" targetRef="Task_EnviarFiltros"/>
    <bpmn:sequenceFlow id="F02" sourceRef="Task_EnviarFiltros" targetRef="Task_BuscarDisponibles"/>
    <bpmn:sequenceFlow id="F03" sourceRef="Task_BuscarDisponibles" targetRef="Gateway_HayResultados"/>
    <bpmn:sequenceFlow id="F04" name="No" sourceRef="Gateway_HayResultados" targetRef="End_Rechazo"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sinResultados</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F05" name="Sí" sourceRef="Gateway_HayResultados" targetRef="Task_Cotizar"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">hayResultados</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F06" sourceRef="Task_Cotizar" targetRef="Task_RevisarCotizacion"/>
    <bpmn:sequenceFlow id="F07" sourceRef="Task_RevisarCotizacion" targetRef="Task_SolicitarReserva"/>
    <bpmn:sequenceFlow id="F08" sourceRef="Task_SolicitarReserva" targetRef="Task_Revalidar"/>
    <bpmn:sequenceFlow id="F09" sourceRef="Task_Revalidar" targetRef="Gateway_Disponible"/>
    <bpmn:sequenceFlow id="F10" name="No" sourceRef="Gateway_Disponible" targetRef="End_Rechazo"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">noDisponible</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F11" name="Sí" sourceRef="Gateway_Disponible" targetRef="Task_ReservarIdempotente"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">disponible</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F12" sourceRef="Task_ReservarIdempotente" targetRef="Task_PagoTest"/>
    <bpmn:sequenceFlow id="F13" sourceRef="Task_PagoTest" targetRef="Gateway_PagoOK"/>
    <bpmn:sequenceFlow id="F14" name="No" sourceRef="Gateway_PagoOK" targetRef="End_Rechazo"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">pagoNoValido</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F15" name="Sí" sourceRef="Gateway_PagoOK" targetRef="Task_ConfirmarBloquear"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">pagoValido</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F16" sourceRef="Task_ConfirmarBloquear" targetRef="Task_AuditarNotificar"/>
    <bpmn:sequenceFlow id="F17" sourceRef="Task_AuditarNotificar" targetRef="End_Confirmada"/>
    <bpmn:textAnnotation id="Annotation_Reglas"><bpmn:text>La búsqueda no garantiza la reserva. Al confirmar se revalida; las reservas son idempotentes y no deben solaparse. Pago exclusivamente simulado. El comportamiento frente a fallos del proveedor debe quedar definido antes de implementar.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_Reglas" sourceRef="Task_Revalidar" targetRef="Annotation_Reglas"/>
  </bpmn:process>
<bpmndi:BPMNDiagram xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Diagram_Proceso_Busqueda_Reserva"><bpmndi:BPMNPlane id="Plane_Proceso_Busqueda_Reserva" bpmnElement="Collab_Proceso_Busqueda_Reserva"><bpmndi:BPMNShape id="Part_Proceso_Busqueda_Reserva_di" bpmnElement="Part_Proceso_Busqueda_Reserva" isHorizontal="true"><dc:Bounds x="40" y="40" width="2690" height="340"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_Huesped_di" bpmnElement="Lane_Huesped" isHorizontal="true"><dc:Bounds x="70" y="40" width="2660" height="170"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_Marketplace_di" bpmnElement="Lane_Marketplace" isHorizontal="true"><dc:Bounds x="70" y="210" width="2660" height="170"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Start_Buscar_di" bpmnElement="Start_Buscar"><dc:Bounds x="182" y="107" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_EnviarFiltros_di" bpmnElement="Task_EnviarFiltros"><dc:Bounds x="310" y="85" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_BuscarDisponibles_di" bpmnElement="Task_BuscarDisponibles"><dc:Bounds x="480" y="255" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Gateway_HayResultados_di" bpmnElement="Gateway_HayResultados"><dc:Bounds x="685" y="270" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_Cotizar_di" bpmnElement="Task_Cotizar"><dc:Bounds x="820" y="255" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_RevisarCotizacion_di" bpmnElement="Task_RevisarCotizacion"><dc:Bounds x="990" y="85" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_SolicitarReserva_di" bpmnElement="Task_SolicitarReserva"><dc:Bounds x="1160" y="85" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_Revalidar_di" bpmnElement="Task_Revalidar"><dc:Bounds x="1330" y="255" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Gateway_Disponible_di" bpmnElement="Gateway_Disponible"><dc:Bounds x="1535" y="270" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_ReservarIdempotente_di" bpmnElement="Task_ReservarIdempotente"><dc:Bounds x="1670" y="255" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_PagoTest_di" bpmnElement="Task_PagoTest"><dc:Bounds x="1840" y="255" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Gateway_PagoOK_di" bpmnElement="Gateway_PagoOK"><dc:Bounds x="2045" y="270" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_ConfirmarBloquear_di" bpmnElement="Task_ConfirmarBloquear"><dc:Bounds x="2180" y="255" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_AuditarNotificar_di" bpmnElement="Task_AuditarNotificar"><dc:Bounds x="2350" y="255" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="End_Rechazo_di" bpmnElement="End_Rechazo"><dc:Bounds x="2222" y="107" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="End_Confirmada_di" bpmnElement="End_Confirmada"><dc:Bounds x="2562" y="107" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="F01_di" bpmnElement="F01"><di:waypoint x="218" y="125"/><di:waypoint x="310" y="125"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F02_di" bpmnElement="F02"><di:waypoint x="430" y="125"/><di:waypoint x="448" y="125"/><di:waypoint x="448" y="295"/><di:waypoint x="480" y="295"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F03_di" bpmnElement="F03"><di:waypoint x="600" y="295"/><di:waypoint x="685" y="295"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F04_di" bpmnElement="F04"><di:waypoint x="735" y="295"/><di:waypoint x="753" y="295"/><di:waypoint x="753" y="125"/><di:waypoint x="2222" y="125"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F05_di" bpmnElement="F05"><di:waypoint x="735" y="295"/><di:waypoint x="820" y="295"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F06_di" bpmnElement="F06"><di:waypoint x="940" y="295"/><di:waypoint x="958" y="295"/><di:waypoint x="958" y="125"/><di:waypoint x="990" y="125"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F07_di" bpmnElement="F07"><di:waypoint x="1110" y="125"/><di:waypoint x="1160" y="125"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F08_di" bpmnElement="F08"><di:waypoint x="1280" y="125"/><di:waypoint x="1298" y="125"/><di:waypoint x="1298" y="295"/><di:waypoint x="1330" y="295"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F09_di" bpmnElement="F09"><di:waypoint x="1450" y="295"/><di:waypoint x="1535" y="295"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="1585" y="295"/><di:waypoint x="1603" y="295"/><di:waypoint x="1603" y="125"/><di:waypoint x="2222" y="125"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="1585" y="295"/><di:waypoint x="1670" y="295"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="1790" y="295"/><di:waypoint x="1840" y="295"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F13_di" bpmnElement="F13"><di:waypoint x="1960" y="295"/><di:waypoint x="2045" y="295"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F14_di" bpmnElement="F14"><di:waypoint x="2095" y="295"/><di:waypoint x="2113" y="295"/><di:waypoint x="2113" y="125"/><di:waypoint x="2222" y="125"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F15_di" bpmnElement="F15"><di:waypoint x="2095" y="295"/><di:waypoint x="2180" y="295"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F16_di" bpmnElement="F16"><di:waypoint x="2300" y="295"/><di:waypoint x="2350" y="295"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F17_di" bpmnElement="F17"><di:waypoint x="2470" y="295"/><di:waypoint x="2488" y="295"/><di:waypoint x="2488" y="125"/><di:waypoint x="2562" y="125"/></bpmndi:BPMNEdge><bpmndi:BPMNShape id="Annotation_Reglas_di" bpmnElement="Annotation_Reglas"><dc:Bounds x="1330" y="-80" width="240" height="70"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Association_Reglas_di" bpmnElement="Association_Reglas"><di:waypoint x="1390" y="255"/><di:waypoint x="1450" y="-10"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>