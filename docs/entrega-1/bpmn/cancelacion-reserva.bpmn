<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Cancelacion" targetNamespace="https://unbosque.edu.co/marketplace/bpmn">
  <bpmn:collaboration id="Collab_Proceso_Cancelacion_Reserva"><bpmn:participant id="Part_Proceso_Cancelacion_Reserva" name="Cancelar reserva según política asociada" processRef="Proceso_Cancelacion_Reserva"/></bpmn:collaboration><bpmn:process id="Proceso_Cancelacion_Reserva" name="Cancelar reserva según política asociada" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Cancelacion">
      <bpmn:lane id="Lane_Huesped" name="Huésped"><bpmn:flowNodeRef>Start_Cancelacion</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Solicitud</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Rechazo</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Cancelada</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Plataforma" name="Marketplace"><bpmn:flowNodeRef>Task_Validar</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Permitida</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ConsultarPolitica</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_GuardarCancelacion</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Liberar</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_LiberarPeriodo</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ConservarPeriodo</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AuditarNotificar</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AuditarRechazo</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Cancelacion" name="Huésped solicita cancelación"><bpmn:outgoing>C01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_Solicitud" name="Enviar motivo de cancelación"><bpmn:incoming>C01</bpmn:incoming><bpmn:outgoing>C02</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Validar" name="Validar titularidad, estado y permisos"><bpmn:incoming>C02</bpmn:incoming><bpmn:outgoing>C03</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Permitida" name="¿Cancelación permitida?"><bpmn:incoming>C03</bpmn:incoming><bpmn:outgoing>C04</bpmn:outgoing><bpmn:outgoing>C06</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_ConsultarPolitica" name="Consultar política asociada al alojamiento y calcular devolución simulada"><bpmn:incoming>C06</bpmn:incoming><bpmn:outgoing>C07</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_GuardarCancelacion" name="Persistir usuario, fecha, motivo, devolución y estado final"><bpmn:incoming>C07</bpmn:incoming><bpmn:outgoing>C08</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Liberar" name="¿La regla autoriza liberar fechas?"><bpmn:incoming>C08</bpmn:incoming><bpmn:outgoing>C09</bpmn:outgoing><bpmn:outgoing>C10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_LiberarPeriodo" name="Liberar periodo de forma consistente"><bpmn:incoming>C09</bpmn:incoming><bpmn:outgoing>C11</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_ConservarPeriodo" name="Conservar bloqueo conforme a la política"><bpmn:incoming>C10</bpmn:incoming><bpmn:outgoing>C12</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_AuditarNotificar" name="Registrar auditoría y notificar participantes"><bpmn:incoming>C11</bpmn:incoming><bpmn:incoming>C12</bpmn:incoming><bpmn:outgoing>C13</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_AuditarRechazo" name="Registrar rechazo relevante sin modificar reserva"><bpmn:incoming>C04</bpmn:incoming><bpmn:outgoing>C05</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_Rechazo" name="Cancelación rechazada; reserva sin cambios"><bpmn:incoming>C05</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="End_Cancelada" name="Cancelación registrada"><bpmn:incoming>C13</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="C01" sourceRef="Start_Cancelacion" targetRef="Task_Solicitud"/>
    <bpmn:sequenceFlow id="C02" sourceRef="Task_Solicitud" targetRef="Task_Validar"/>
    <bpmn:sequenceFlow id="C03" sourceRef="Task_Validar" targetRef="Gateway_Permitida"/>
    <bpmn:sequenceFlow id="C04" name="No" sourceRef="Gateway_Permitida" targetRef="Task_AuditarRechazo"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">noPermitida</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="C05" sourceRef="Task_AuditarRechazo" targetRef="End_Rechazo"/>
    <bpmn:sequenceFlow id="C06" name="Sí" sourceRef="Gateway_Permitida" targetRef="Task_ConsultarPolitica"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">permitida</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="C07" sourceRef="Task_ConsultarPolitica" targetRef="Task_GuardarCancelacion"/>
    <bpmn:sequenceFlow id="C08" sourceRef="Task_GuardarCancelacion" targetRef="Gateway_Liberar"/>
    <bpmn:sequenceFlow id="C09" name="Sí" sourceRef="Gateway_Liberar" targetRef="Task_LiberarPeriodo"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">liberar</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="C10" name="No" sourceRef="Gateway_Liberar" targetRef="Task_ConservarPeriodo"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">conservar</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="C11" sourceRef="Task_LiberarPeriodo" targetRef="Task_AuditarNotificar"/>
    <bpmn:sequenceFlow id="C12" sourceRef="Task_ConservarPeriodo" targetRef="Task_AuditarNotificar"/>
    <bpmn:sequenceFlow id="C13" sourceRef="Task_AuditarNotificar" targetRef="End_Cancelada"/>
    <bpmn:textAnnotation id="Annotation_Politica"><bpmn:text>La guía exige guardar usuario, fecha, motivo, devolución aplicable y estado final. La devolución es simulada y no implica transacción monetaria real.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_Politica" sourceRef="Task_ConsultarPolitica" targetRef="Annotation_Politica"/>
  </bpmn:process>
<bpmndi:BPMNDiagram xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Diagram_Proceso_Cancelacion_Reserva"><bpmndi:BPMNPlane id="Plane_Proceso_Cancelacion_Reserva" bpmnElement="Collab_Proceso_Cancelacion_Reserva"><bpmndi:BPMNShape id="Part_Proceso_Cancelacion_Reserva_di" bpmnElement="Part_Proceso_Cancelacion_Reserva" isHorizontal="true"><dc:Bounds x="40" y="40" width="1840" height="470"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_Huesped_di" bpmnElement="Lane_Huesped" isHorizontal="true"><dc:Bounds x="70" y="40" width="1810" height="170"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_Plataforma_di" bpmnElement="Lane_Plataforma" isHorizontal="true"><dc:Bounds x="70" y="210" width="1810" height="300"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Start_Cancelacion_di" bpmnElement="Start_Cancelacion"><dc:Bounds x="182" y="107" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_Solicitud_di" bpmnElement="Task_Solicitud"><dc:Bounds x="310" y="85" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_Validar_di" bpmnElement="Task_Validar"><dc:Bounds x="480" y="255" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Gateway_Permitida_di" bpmnElement="Gateway_Permitida"><dc:Bounds x="685" y="270" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_ConsultarPolitica_di" bpmnElement="Task_ConsultarPolitica"><dc:Bounds x="820" y="385" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_GuardarCancelacion_di" bpmnElement="Task_GuardarCancelacion"><dc:Bounds x="990" y="255" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Gateway_Liberar_di" bpmnElement="Gateway_Liberar"><dc:Bounds x="1195" y="270" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_LiberarPeriodo_di" bpmnElement="Task_LiberarPeriodo"><dc:Bounds x="1330" y="255" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_ConservarPeriodo_di" bpmnElement="Task_ConservarPeriodo"><dc:Bounds x="1330" y="385" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_AuditarNotificar_di" bpmnElement="Task_AuditarNotificar"><dc:Bounds x="1500" y="255" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_AuditarRechazo_di" bpmnElement="Task_AuditarRechazo"><dc:Bounds x="820" y="255" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="End_Rechazo_di" bpmnElement="End_Rechazo"><dc:Bounds x="1032" y="107" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="End_Cancelada_di" bpmnElement="End_Cancelada"><dc:Bounds x="1712" y="107" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="C01_di" bpmnElement="C01"><di:waypoint x="218" y="125"/><di:waypoint x="310" y="125"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="C02_di" bpmnElement="C02"><di:waypoint x="430" y="125"/><di:waypoint x="448" y="125"/><di:waypoint x="448" y="295"/><di:waypoint x="480" y="295"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="C03_di" bpmnElement="C03"><di:waypoint x="600" y="295"/><di:waypoint x="685" y="295"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="C04_di" bpmnElement="C04"><di:waypoint x="735" y="295"/><di:waypoint x="820" y="295"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="C05_di" bpmnElement="C05"><di:waypoint x="940" y="295"/><di:waypoint x="958" y="295"/><di:waypoint x="958" y="125"/><di:waypoint x="1032" y="125"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="C06_di" bpmnElement="C06"><di:waypoint x="735" y="295"/><di:waypoint x="767" y="295"/><di:waypoint x="767" y="425"/><di:waypoint x="820" y="425"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="C07_di" bpmnElement="C07"><di:waypoint x="940" y="425"/><di:waypoint x="958" y="425"/><di:waypoint x="958" y="295"/><di:waypoint x="990" y="295"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="C08_di" bpmnElement="C08"><di:waypoint x="1110" y="295"/><di:waypoint x="1195" y="295"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="C09_di" bpmnElement="C09"><di:waypoint x="1245" y="295"/><di:waypoint x="1330" y="295"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="C10_di" bpmnElement="C10"><di:waypoint x="1245" y="295"/><di:waypoint x="1277" y="295"/><di:waypoint x="1277" y="425"/><di:waypoint x="1330" y="425"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="C11_di" bpmnElement="C11"><di:waypoint x="1450" y="295"/><di:waypoint x="1500" y="295"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="C12_di" bpmnElement="C12"><di:waypoint x="1450" y="425"/><di:waypoint x="1468" y="425"/><di:waypoint x="1468" y="295"/><di:waypoint x="1500" y="295"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="C13_di" bpmnElement="C13"><di:waypoint x="1620" y="295"/><di:waypoint x="1638" y="295"/><di:waypoint x="1638" y="125"/><di:waypoint x="1712" y="125"/></bpmndi:BPMNEdge><bpmndi:BPMNShape id="Annotation_Politica_di" bpmnElement="Annotation_Politica"><dc:Bounds x="820" y="-80" width="240" height="70"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Association_Politica_di" bpmnElement="Association_Politica"><di:waypoint x="880" y="385"/><di:waypoint x="940" y="-10"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>