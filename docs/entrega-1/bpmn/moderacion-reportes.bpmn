    <bpmndi:BPMNShape id="Task_Rechazar_di" bpmnElement="Task_Rechazar"><dc:Bounds x="655" y="250" width="130" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="End_Rechazo_di" bpmnElement="End_Rechazo"><dc:Bounds x="882" y="107" width="36" height="36"/></bpmndi:BPMNShape>
