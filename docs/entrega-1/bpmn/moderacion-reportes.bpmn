    <bpmndi:BPMNShape id="Task_Restringir_di" bpmnElement="Task_Restringir"><dc:Bounds x="835" y="380" width="130" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_Bloquear_di" bpmnElement="Task_Bloquear"><dc:Bounds x="835" y="510" width="130" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_MarcarReservas_di" bpmnElement="Task_MarcarReservas"><dc:Bounds x="1005" y="510" width="130" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_NotificarAnfitrion_di" bpmnElement="Task_NotificarAnfitrion"><dc:Bounds x="1175" y="510" width="130" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_OcultarResena_di" bpmnElement="Task_OcultarResena"><dc:Bounds x="835" y="640" width="130" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_ResolverRevision_di" bpmnElement="Task_ResolverRevision"><dc:Bounds x="835" y="770" width="130" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_Indicadores_di" bpmnElement="Task_Indicadores"><dc:Bounds x="835" y="900" width="130" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_Generar_di" bpmnElement="Task_Generar"><dc:Bounds x="1005" y="900" width="130" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Gateway_Union_di" bpmnElement="Gateway_Union" isMarkerVisible="true"><dc:Bounds x="1375" y="395" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_Auditar_di" bpmnElement="Task_Auditar"><dc:Bounds x="1475" y="380" width="130" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_Revisar_di" bpmnElement="Task_Revisar"><dc:Bounds x="1635" y="85" width="130" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="End_Registrada_di" bpmnElement="End_Registrada"><dc:Bounds x="1852" y="107" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="M01_di" bpmnElement="M01"><di:waypoint x="178" y="125"/><di:waypoint x="225" y="125"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="M02_di" bpmnElement="M02"><di:waypoint x="355" y="125"/><di:waypoint x="375" y="125"/><di:waypoint x="375" y="420"/><di:waypoint x="385" y="420"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="M03_di" bpmnElement="M03"><di:waypoint x="515" y="420"/><di:waypoint x="575" y="420"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="M04_di" bpmnElement="M04"><di:waypoint x="600" y="395"/><di:waypoint x="600" y="290"/><di:waypoint x="655" y="290"/><bpmndi:BPMNLabel><dc:Bounds x="606" y="335" width="20" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="M05_di" bpmnElement="M05"><di:waypoint x="785" y="290"/><di:waypoint x="810" y="290"/><di:waypoint x="810" y="125"/><di:waypoint x="882" y="125"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="M06_di" bpmnElement="M06"><di:waypoint x="625" y="420"/><di:waypoint x="715" y="420"/><bpmndi:BPMNLabel><dc:Bounds x="645" y="400" width="20" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="M07_di" bpmnElement="M07"><di:waypoint x="765" y="420"/><di:waypoint x="835" y="420"/><bpmndi:BPMNLabel><dc:Bounds x="755" y="398" width="70" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="M08_di" bpmnElement="M08"><di:waypoint x="740" y="445"/><di:waypoint x="740" y="550"/><di:waypoint x="835" y="550"/><bpmndi:BPMNLabel><dc:Bounds x="755" y="528" width="70" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
