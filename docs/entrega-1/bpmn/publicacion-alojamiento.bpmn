<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Publicacion" targetNamespace="https://unbosque.edu.co/marketplace/bpmn">
  <bpmn:process id="Proceso_Publicacion_Alojamiento" name="Publicar y moderar alojamiento" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Publicacion">
      <bpmn:lane id="Lane_Anfitrion" name="Anfitrión"><bpmn:flowNodeRef>Start_Crear</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Diligenciar</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ValidarCampos</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_DatosValidos</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Corregir</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_GuardarPendiente</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_RequiereRevision</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Publicada</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Plataforma" name="Marketplace"><bpmn:flowNodeRef>Task_Auditar</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Administrador" name="Administrador"><bpmn:flowNodeRef>Task_Revisar</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Aprobada</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Activar</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_DevolverCorreccion</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Pendiente</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Crear" name="Anfitrión autenticado crea anuncio"/>
    <bpmn:task id="Task_Diligenciar" name="Diligenciar datos del alojamiento"/>
    <bpmn:task id="Task_ValidarCampos" name="Validar datos mínimos, capacidad y precio"/>
    <bpmn:exclusiveGateway id="Gateway_DatosValidos" name="¿Datos válidos?"/>
    <bpmn:task id="Task_Corregir" name="Mostrar errores y permitir corrección"/>
    <bpmn:task id="Task_GuardarPendiente" name="Guardar publicación como borrador o pendiente de revisión"/>
    <bpmn:exclusiveGateway id="Gateway_RequiereRevision" name="¿Requiere revisión?"/>
    <bpmn:task id="Task_Revisar" name="Revisar publicación y motivo"/>
    <bpmn:exclusiveGateway id="Gateway_Aprobada" name="¿Aprobada?"/>
    <bpmn:task id="Task_Activar" name="Activar publicación"/>
    <bpmn:task id="Task_DevolverCorreccion" name="Devolver para corrección"/>
    <bpmn:task id="Task_Auditar" name="Registrar actor, fecha, estado y resultado"/>
    <bpmn:endEvent id="End_Publicada" name="Publicación activa y visible en búsqueda"/>
    <bpmn:endEvent id="End_Pendiente" name="Publicación pendiente o devuelta"/>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Crear" targetRef="Task_Diligenciar"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Diligenciar" targetRef="Task_ValidarCampos"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ValidarCampos" targetRef="Gateway_DatosValidos"/>
    <bpmn:sequenceFlow id="Flow_04" name="No" sourceRef="Gateway_DatosValidos" targetRef="Task_Corregir"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">datosInvalidos</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_Corregir" targetRef="Task_Diligenciar"/>
    <bpmn:sequenceFlow id="Flow_06" name="Sí" sourceRef="Gateway_DatosValidos" targetRef="Task_GuardarPendiente"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">datosValidos</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_GuardarPendiente" targetRef="Gateway_RequiereRevision"/>
    <bpmn:sequenceFlow id="Flow_08" name="Sí" sourceRef="Gateway_RequiereRevision" targetRef="Task_Revisar"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">revisionRequerida</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09" name="No" sourceRef="Gateway_RequiereRevision" targetRef="Task_Activar"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">revisionNoRequerida</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Revisar" targetRef="Gateway_Aprobada"/>
    <bpmn:sequenceFlow id="Flow_11" name="Sí" sourceRef="Gateway_Aprobada" targetRef="Task_Activar"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aprobada</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" name="No" sourceRef="Gateway_Aprobada" targetRef="Task_DevolverCorreccion"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">noAprobada</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_DevolverCorreccion" targetRef="Task_Auditar"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Activar" targetRef="Task_Auditar"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_Auditar" targetRef="End_Publicada"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_Auditar" targetRef="End_Pendiente"/>
    <bpmn:textAnnotation id="Annotation_Validaciones"><bpmn:text>Capacidad mayor que cero; precio por noche positivo; información mínima completa. Solo publicaciones activas se encuentran y reservan.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_Validaciones" sourceRef="Task_ValidarCampos" targetRef="Annotation_Validaciones"/>
  </bpmn:process>
</bpmn:definitions>
