<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Publicacion" targetNamespace="https://unbosque.edu.co/marketplace/bpmn">
  <bpmn:collaboration id="Collab_Proceso_Publicacion_Alojamiento"><bpmn:participant id="Part_Proceso_Publicacion_Alojamiento" name="Publicar y moderar alojamiento" processRef="Proceso_Publicacion_Alojamiento"/></bpmn:collaboration><bpmn:process id="Proceso_Publicacion_Alojamiento" name="Publicar y moderar alojamiento" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Publicacion">
      <bpmn:lane id="Lane_Anfitrion" name="Anfitrión">
        <bpmn:flowNodeRef>Start_Crear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Diligenciar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidarCampos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DatosValidos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Corregir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GuardarPendiente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RequiereRevision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Plataforma" name="Marketplace">
        <bpmn:flowNodeRef>Task_AuditarActivacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AuditarPendiente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Activar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Administrador" name="Administrador">
        <bpmn:flowNodeRef>Task_Revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Aprobada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DevolverCorreccion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Publicada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Pendiente</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Crear" name="Anfitrión autenticado inicia publicación"><bpmn:outgoing>Flow_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_Diligenciar" name="Diligenciar datos del alojamiento"><bpmn:incoming>Flow_01</bpmn:incoming><bpmn:outgoing>Flow_02</bpmn:outgoing><bpmn:incoming>Flow_05</bpmn:incoming></bpmn:task>
    <bpmn:task id="Task_ValidarCampos" name="Validar datos mínimos, capacidad y precio"><bpmn:incoming>Flow_02</bpmn:incoming><bpmn:outgoing>Flow_03</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_DatosValidos" name="¿Datos válidos?"><bpmn:incoming>Flow_03</bpmn:incoming><bpmn:outgoing>Flow_04</bpmn:outgoing><bpmn:outgoing>Flow_06</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_Corregir" name="Mostrar errores y permitir corrección"><bpmn:incoming>Flow_04</bpmn:incoming><bpmn:outgoing>Flow_05</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_GuardarPendiente" name="Guardar publicación como borrador o pendiente de revisión"><bpmn:incoming>Flow_06</bpmn:incoming><bpmn:outgoing>Flow_07</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_RequiereRevision" name="¿Requiere revisión?"><bpmn:incoming>Flow_07</bpmn:incoming><bpmn:outgoing>Flow_08</bpmn:outgoing><bpmn:outgoing>Flow_09</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_Revisar" name="Revisar publicación y motivo"><bpmn:incoming>Flow_08</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Aprobada" name="¿Aprobada?"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_Activar" name="Activar publicación"><bpmn:incoming>Flow_09</bpmn:incoming><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_DevolverCorreccion" name="Devolver para corrección"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_AuditarActivacion" name="Registrar activación y hacer visible en búsqueda"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_AuditarPendiente" name="Registrar estado pendiente y decisión de revisión"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_Publicada" name="Publicación activa y visible en búsqueda"><bpmn:incoming>Flow_15</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="End_Pendiente" name="Publicación pendiente o devuelta"><bpmn:incoming>Flow_16</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Crear" targetRef="Task_Diligenciar"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Diligenciar" targetRef="Task_ValidarCampos"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ValidarCampos" targetRef="Gateway_DatosValidos"/>
    <bpmn:sequenceFlow id="Flow_04" name="No" sourceRef="Gateway_DatosValidos" targetRef="Task_Corregir"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">datosInvalidos</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_Corregir" targetRef="Task_Diligenciar"/>
    <bpmn:sequenceFlow id="Flow_06" name="Sí" sourceRef="Gateway_DatosValidos" targetRef="Task_GuardarPendiente"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">datosValidos</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_GuardarPendiente" targetRef="Gateway_RequiereRevision"/>
    <bpmn:sequenceFlow id="Flow_08" name="Sí" sourceRef="Gateway_RequiereRevision" targetRef="Task_Revisar"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">revisionRequerida</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09" name="No" sourceRef="Gateway_RequiereRevision" targetRef="Task_Activar"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">revisionNoRequerida</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Revisar" targetRef="Gateway_Aprobada"/>
    <bpmn:sequenceFlow id="Flow_11" name="Sí" sourceRef="Gateway_Aprobada" targetRef="Task_Activar"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aprobada</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" name="No" sourceRef="Gateway_Aprobada" targetRef="Task_DevolverCorreccion"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">noAprobada</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_DevolverCorreccion" targetRef="Task_AuditarPendiente"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Activar" targetRef="Task_AuditarActivacion"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_AuditarActivacion" targetRef="End_Publicada"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_AuditarPendiente" targetRef="End_Pendiente"/>
    <bpmn:textAnnotation id="Annotation_Validaciones"><bpmn:text>Capacidad mayor que cero; precio por noche positivo; información mínima completa. Solo publicaciones activas se encuentran y reservan.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_Validaciones" sourceRef="Task_ValidarCampos" targetRef="Annotation_Validaciones"/>
  </bpmn:process>
<bpmndi:BPMNDiagram xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Diagram_Proceso_Publicacion_Alojamiento"><bpmndi:BPMNPlane id="Plane_Proceso_Publicacion_Alojamiento" bpmnElement="Collab_Proceso_Publicacion_Alojamiento"><bpmndi:BPMNShape id="Part_Proceso_Publicacion_Alojamiento_di" bpmnElement="Part_Proceso_Publicacion_Alojamiento" isHorizontal="true"><dc:Bounds x="40" y="40" width="2010" height="900"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_Anfitrion_di" bpmnElement="Lane_Anfitrion" isHorizontal="true"><dc:Bounds x="70" y="40" width="1980" height="300"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_Plataforma_di" bpmnElement="Lane_Plataforma" isHorizontal="true"><dc:Bounds x="70" y="340" width="1980" height="300"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_Administrador_di" bpmnElement="Lane_Administrador" isHorizontal="true"><dc:Bounds x="70" y="640" width="1980" height="300"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Start_Crear_di" bpmnElement="Start_Crear"><dc:Bounds x="182" y="107" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_Diligenciar_di" bpmnElement="Task_Diligenciar"><dc:Bounds x="310" y="85" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_ValidarCampos_di" bpmnElement="Task_ValidarCampos"><dc:Bounds x="480" y="85" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Gateway_DatosValidos_di" bpmnElement="Gateway_DatosValidos"><dc:Bounds x="685" y="100" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_Corregir_di" bpmnElement="Task_Corregir"><dc:Bounds x="820" y="85" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_GuardarPendiente_di" bpmnElement="Task_GuardarPendiente"><dc:Bounds x="820" y="215" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Gateway_RequiereRevision_di" bpmnElement="Gateway_RequiereRevision"><dc:Bounds x="1025" y="100" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_Revisar_di" bpmnElement="Task_Revisar"><dc:Bounds x="1160" y="685" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Gateway_Aprobada_di" bpmnElement="Gateway_Aprobada"><dc:Bounds x="1365" y="700" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_Activar_di" bpmnElement="Task_Activar"><dc:Bounds x="1500" y="385" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_DevolverCorreccion_di" bpmnElement="Task_DevolverCorreccion"><dc:Bounds x="1500" y="685" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_AuditarActivacion_di" bpmnElement="Task_AuditarActivacion"><dc:Bounds x="1670" y="385" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_AuditarPendiente_di" bpmnElement="Task_AuditarPendiente"><dc:Bounds x="1670" y="515" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="End_Publicada_di" bpmnElement="End_Publicada"><dc:Bounds x="1882" y="707" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="End_Pendiente_di" bpmnElement="End_Pendiente"><dc:Bounds x="1882" y="837" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01"><di:waypoint x="218" y="125"/><di:waypoint x="310" y="125"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02"><di:waypoint x="430" y="125"/><di:waypoint x="480" y="125"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03"><di:waypoint x="600" y="125"/><di:waypoint x="685" y="125"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04"><di:waypoint x="735" y="125"/><di:waypoint x="820" y="125"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05"><di:waypoint x="880" y="165"/><di:waypoint x="880" y="190"/><di:waypoint x="370" y="190"/><di:waypoint x="370" y="165"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06"><di:waypoint x="735" y="125"/><di:waypoint x="767" y="125"/><di:waypoint x="767" y="255"/><di:waypoint x="820" y="255"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_07_di" bpmnElement="Flow_07"><di:waypoint x="940" y="255"/><di:waypoint x="958" y="255"/><di:waypoint x="958" y="125"/><di:waypoint x="1025" y="125"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_08_di" bpmnElement="Flow_08"><di:waypoint x="1075" y="125"/><di:waypoint x="1093" y="125"/><di:waypoint x="1093" y="725"/><di:waypoint x="1160" y="725"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_09_di" bpmnElement="Flow_09"><di:waypoint x="1075" y="125"/><di:waypoint x="1107" y="125"/><di:waypoint x="1107" y="425"/><di:waypoint x="1500" y="425"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1280" y="725"/><di:waypoint x="1365" y="725"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="1415" y="725"/><di:waypoint x="1433" y="725"/><di:waypoint x="1433" y="425"/><di:waypoint x="1500" y="425"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="1415" y="725"/><di:waypoint x="1500" y="725"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13"><di:waypoint x="1620" y="725"/><di:waypoint x="1638" y="725"/><di:waypoint x="1638" y="555"/><di:waypoint x="1670" y="555"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14"><di:waypoint x="1620" y="425"/><di:waypoint x="1670" y="425"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15"><di:waypoint x="1790" y="425"/><di:waypoint x="1808" y="425"/><di:waypoint x="1808" y="725"/><di:waypoint x="1882" y="725"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_16_di" bpmnElement="Flow_16"><di:waypoint x="1790" y="555"/><di:waypoint x="1808" y="555"/><di:waypoint x="1808" y="855"/><di:waypoint x="1882" y="855"/></bpmndi:BPMNEdge><bpmndi:BPMNShape id="Annotation_Validaciones_di" bpmnElement="Annotation_Validaciones"><dc:Bounds x="480" y="-80" width="240" height="70"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Association_Validaciones_di" bpmnElement="Association_Validaciones"><di:waypoint x="540" y="85"/><di:waypoint x="600" y="-10"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>