// Pipeline CI/CD real del proyecto.
// Fuente: .github/workflows/ci.yml, .github/workflows/sonarcloud.yml, .github/dependabot.yml y docs/DESPLIEGUE-EC2.md.
// La integración continua es automática; la entrega a EC2 es manual (no hay despliegue continuo).
// Generar: dot -Tpng -Gdpi=110 20-pipeline-ci-cd.dot -o ../20-pipeline-ci-cd.png
digraph Pipeline {
  graph [rankdir=TB, fontname="DejaVu Sans", fontsize=20, pad=0.4, nodesep=0.35, ranksep=0.45, compound=true, newrank=true,
         label=<<B>Pipeline CI/CD - Marketplace de Alojamientos</B><BR/><FONT POINT-SIZE="13">Integración continua automática en GitHub Actions y SonarCloud; entrega a la instancia EC2 manual y verificada.</FONT>>,
         labelloc=t];
  node [fontname="DejaVu Sans", fontsize=10, shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#555555"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#444444", fontcolor="#333333", arrowsize=0.7];

  dev [shape=box, fillcolor="#08427B", fontcolor=white, color="#052E56", label=<<B>Desarrollador</B><BR/>commit en rama<BR/>feature/* o docs/*>];
  dep [fillcolor="#F4F4F4", label=<<B>Dependabot</B><BR/>semanal: Actions,<BR/>Maven y npm>];
  pr [fillcolor="#F0F0F0", label=<<B>Pull Request</B><BR/>hacia develop o main<BR/>(plantilla de PR)>];

  subgraph cluster_ci {
    label=<<B>Integración continua</B> - workflow CI (.github/workflows/ci.yml)<BR/>Se dispara en pull_request y push a main y develop>; fontsize=11; style="rounded,filled"; fillcolor="#EEF5FC"; color="#2E6295";

    subgraph cluster_b { label="Backend CI"; style="rounded"; color="#7A9CC6"; fontsize=10;
      b1 [label="checkout"]; b2 [label="Java 21 (Temurin)\ncaché Maven"]; b3 [label=<<B>mvn -B verify</B><BR/>compila, pruebas JUnit<BR/>y cobertura JaCoCo>];
      b1 -> b2 -> b3; }
    subgraph cluster_f { label="Frontend CI"; style="rounded"; color="#7A9CC6"; fontsize=10;
      f1 [label="checkout"]; f2 [label="Node.js 22\nnpm ci"]; f3 [label="npm run lint"]; f4 [label="npm test\n(node --test + c8)"]; f5 [label="npm run build"];
      f1 -> f2 -> f3 -> f4 -> f5; }
    subgraph cluster_d { label="Documentation CI"; style="rounded"; color="#7A9CC6"; fontsize=10;
      d1 [label="checkout"]; d2 [label="Python 3.12\nPyYAML"]; d3 [label=<<B>validate_delivery_docs.py</B><BR/>OpenAPI, BPMN,<BR/>trazabilidad y enlaces>];
      d1 -> d2 -> d3; }
  }

  subgraph cluster_sonar {
    label=<<B>Calidad</B> - workflow SonarCloud (.github/workflows/sonarcloud.yml)<BR/>En pull_request y push a main>; fontsize=11; style="rounded,filled"; fillcolor="#F3F8EE"; color="#3E6B23";
    s1 [label="mvn verify\n+ npm test y build"]; s2 [label="Análisis SonarCloud\n(cobertura lcov y JaCoCo)"]; s3 [label=<<B>Quality Gate</B>>];
    s1 -> s2 -> s3;
  }

  ok [shape=diamond, style=filled, fillcolor="#FFF7D6", color="#8A6D00", label="¿Todos los\nchecks en verde?"];
  fix [fillcolor="#FDECEA", color="#C0392B", label="Corregir y\nvolver a subir"];
  rev [label=<<B>Revisión del PR</B><BR/>por el otro integrante>];
  merge_dev [label=<<B>Merge a develop</B>>];
  merge_main [label=<<B>PR develop a main</B><BR/>y merge>];

  subgraph cluster_cd {
    label=<<B>Entrega a la demostración</B> - manual (docs/DESPLIEGUE-EC2.md)>; fontsize=11; style="rounded,filled"; fillcolor="#FFF4E0"; color="#E07B00";
    c1 [label="Compilar JAR y frontend\ndesde el commit aprobado"];
    c2 [label="Copiar a /srv/marketplace/\nreleases/VERSION en EC2"];
    c3 [label="Apuntar enlace current\na la nueva versión"];
    c4 [label="systemctl restart\nmarketplace"];
    c5 [label="Verificar /api/health,\nmodo de pago y flujo demo"];
    c6 [shape=diamond, style=filled, fillcolor="#FFF7D6", color="#8A6D00", label="¿Funciona?"];
    c7 [label="Reversión: current\na la versión anterior"];
    {rank=same; c1; c2; c3;}
    {rank=same; c6; c7;}
    c1 -> c2 -> c3; c3 -> c4; c4 -> c5 -> c6;
    c6 -> c7 [label="No"];
  }
  pub [shape=box, fillcolor="#3E6B23", fontcolor=white, color="#2C4D18", label=<<B>Publicado</B><BR/>moralesforero.lol>];

  dev -> pr; dep -> pr;
  pr -> b1 [lhead=cluster_ci];
  pr -> s1 [lhead=cluster_sonar];
  b3 -> ok; f5 -> ok; d3 -> ok; s3 -> ok;
  ok -> fix [label="No"]; fix -> dev [constraint=false, style=dashed];
  ok -> rev [label="Sí"];
  rev -> merge_dev -> merge_main;
  merge_main -> c1 [lhead=cluster_cd, label="cuando el equipo\ndecide publicar", style=dashed];
  c6 -> pub [label="Sí"];

  nota [shape=note, style=filled, fillcolor="#F5F5F5", color="#999999", fontsize=9, label=<<B>Pendientes registrados</B><BR ALIGN="LEFT"/>- La protección de ramas de main y develop no está activada<BR ALIGN="LEFT"/>  (existe scripts/configure-github-branch-protection.sh).<BR ALIGN="LEFT"/>- No hay paso automático de despliegue: el pipeline llega<BR ALIGN="LEFT"/>  a entrega continua parcial, no a despliegue continuo.<BR ALIGN="LEFT"/>- No hay releases versionados en GitHub (MARKET-80).<BR ALIGN="LEFT"/>>];
  pub -> nota [style=invis];
}
