#!/usr/bin/env python3
"""Prepare sandbox credentials in root-only tmpfs; never write values to logs."""
import os
from pathlib import Path
import re
import subprocess
import sys

ROOT = Path('/run/marketplace-stripe-credentials')
KEY_PATH = ROOT / 'stripe-key'
WEBHOOK_PATH = ROOT / 'webhook-secret'
STRIPE = '/opt/marketplace/stripe-cli/stripe'
AWS = '/usr/bin/aws'
CONFIG = '/var/lib/marketplace-stripe/config'

def output(command, timeout=45):
    return subprocess.run(command, capture_output=True, text=True, timeout=timeout, check=True).stdout.strip()

def remove_generated_files():
    if not ROOT.is_symlink() and ROOT.is_dir() and ROOT.stat().st_uid == 0 and not (ROOT.stat().st_mode & 0o077):
        for name in (KEY_PATH, WEBHOOK_PATH):
            name.unlink(missing_ok=True)

def write_secret(path, value):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'w', encoding='utf-8') as handle:
        handle.write(value)

try:
    os.environ.pop('STRIPE_API_KEY', None)
    if os.geteuid() != 0 or not Path('/etc/marketplace/stripe-sandbox-enabled').is_file():
        raise ValueError('preflight')
    if output(['/usr/bin/findmnt', '-n', '-o', 'FSTYPE', '-T', '/run']) != 'tmpfs':
        raise ValueError('runtime storage')
    if len(Path('/proc/swaps').read_text(encoding='utf-8').splitlines()) != 1:
        raise ValueError('swap enabled')
    # RuntimeDirectory is created by systemd as root:root 0700. Never follow a link.
    if ROOT.is_symlink() or not ROOT.is_dir() or ROOT.stat().st_uid != 0 or (ROOT.stat().st_mode & 0o077):
        raise ValueError('runtime directory')
    remove_generated_files()
    key = output(['/usr/sbin/runuser', '-u', 'marketplace-secrets', '--', AWS,
                  '--region', 'us-east-2', '--no-cli-pager', '--no-cli-auto-prompt', 'ssm', 'get-parameter',
                  '--name', '/marketplace/demo/stripe-test-key', '--with-decryption',
                  '--query', 'Parameter.Value', '--output', 'text'])
    if not re.fullmatch(r'rk_test_[A-Za-z0-9]+', key):
        raise ValueError('key must be a restricted sandbox key')
    common = ['/usr/sbin/runuser', '-u', 'marketplace-stripe', '--', '/usr/bin/env',
              'XDG_CONFIG_HOME=' + CONFIG, 'STRIPE_NO_AUTO_UPDATE=1']
    output(common + ['/usr/local/libexec/marketplace/verify-stripe-sandbox'])
    signing = output(common + [STRIPE, 'listen', '--print-secret'])
    if not re.fullmatch(r'whsec_[A-Za-z0-9]+', signing):
        raise ValueError('invalid test webhook secret')
    write_secret(KEY_PATH, key)
    write_secret(WEBHOOK_PATH, signing)
except (OSError, subprocess.SubprocessError, ValueError):
    remove_generated_files()
    # Child output may contain keys or account data; do not print it.
    print('No se pudieron preparar las credenciales de Stripe de prueba.', file=sys.stderr)
    sys.exit(1)
