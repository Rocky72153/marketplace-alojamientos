[Unit]
Description=Ephemeral credentials for marketplace Stripe sandbox
After=network-online.target
ConditionPathExists=/etc/marketplace/stripe-sandbox-enabled

[Service]
Type=oneshot
RemainAfterExit=true
RuntimeDirectory=marketplace-stripe-credentials
RuntimeDirectoryMode=0700
ExecStart=/usr/local/libexec/marketplace/prepare-stripe-credentials
ExecStop=/usr/local/libexec/marketplace/remove-stripe-credentials
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/marketplace-stripe-credentials
ReadWritePaths=/var/lib/marketplace-stripe
