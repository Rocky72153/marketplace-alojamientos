#!/usr/bin/env python3
"""Remove only the two ephemeral files created by the matching preparation unit."""
from pathlib import Path

directory = Path('/run/marketplace-stripe-credentials')
if not directory.is_symlink() and directory.is_dir() and directory.stat().st_uid == 0:
    for name in ('stripe-key', 'webhook-secret'):
        (directory / name).unlink(missing_ok=True)
