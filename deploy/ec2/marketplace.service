[Unit]
Description=Marketplace de Alojamientos
Wants=network-online.target
After=network-online.target postgresql.service
Requires=postgresql.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=marketplace
Group=marketplace
EnvironmentFile=/etc/marketplace/marketplace.env
WorkingDirectory=/srv/marketplace/current
ExecStart=/usr/bin/java -Xms64m -Xmx384m -XX:+ExitOnOutOfMemoryError -jar /srv/marketplace/current/marketplace.jar
# Java exits with 128 + SIGTERM after a normal graceful shutdown.
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
